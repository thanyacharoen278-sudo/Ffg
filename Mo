-- ==================== HELPERS ====================
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function InstantTP(cf)
    local h = getHRP()
    if h then h.CFrame = cf end
end
local function TweenTo(cf, spd)
    local h = getHRP()
    if not h then return end
    local d = (h.Position - cf.Position).Magnitude
    local t = math.clamp(d / (spd or 300), 0.1, 10)
    local tw = TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = cf})
    tw:Play()
    tw.Completed:Wait()
end

