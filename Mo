EspSec:addButton("TP ไปผลใกล้สุด", function()
    local hrp = getHRP()
    if not hrp then return end
    local nearest, dist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        local isFruit = false
        local part = nil
        if obj:IsA("Tool") and obj:FindFirstChild("Handle") and string.find(obj.Name:lower(), "fruit") then
            isFruit, part = true, obj.Handle
        elseif (obj:IsA("MeshPart") or obj:IsA("Part")) and (string.find(obj.Name:lower(), "fruit") or (obj.Parent and string.find(tostring(obj.Parent.Name):lower(), "fruit"))) then
            isFruit, part = true, obj
        end
        if isFruit and part then
            local d = (hrp.Position - part.Position).Magnitude
            if d < dist and d > 3 then nearest, dist = part, d end
        end
    end
    if nearest then InstantTP(nearest.CFrame + Vector3.new(0, 3, 0)) end
end)

