local function Char()
    return LP.Character
end

local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetLevel()
    local ok, v = pcall(function()
        return LP.Data.Level.Value
    end)
    return ok and v or 0
end

local function CommF_(...)
    local a = { ... }
    return pcall(function()
        return RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(a))
    end)
end

local function EquipTool(name)
    if not name or name == "None" then return end
    pcall(function()
        local hum = Hum()
        local char = Char()
        if not hum or not char then return end
        if char:FindFirstChild(name) then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        local t = bag:FindFirstChild(name)
        if t and t:IsA("Tool") then
            hum:EquipTool(t)
        end
    end)
end

local function GetArea()
    local lv = GetLevel()
    for _, a in ipairs(FarmAreas) do
        if lv >= a.MinLevel and lv <= a.MaxLevel then
            return a
        end
    end
    return FarmAreas[#FarmAreas]
end

local function cancelTween(t)
    if t then
        pcall(function() t:Cancel() end)
    end
end

local function SetIslandGoal(cf)
    if cf then
        islandGoal = cf.Position + Vector3.new(0, 8, 0)
        cancelTween(islandTween)
        islandTween = nil
    end
end

local function freezeHum()
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function zeroVel(h)
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function FlyToIsland()
    local h = HRP()
    if not h or not islandGoal then return true end

    local cur = h.Position
    local dist = (islandGoal - cur).Magnitude

    if dist < islandArriveDist then
        islandGoal = nil
        cancelTween(islandTween)
        islandTween = nil
        return true
    end

    if islandTween and islandTween.PlaybackState == Enum.PlaybackState.Playing then
        zeroVel(h)
        freezeHum()
        return false
    end

    local maxStep = 26
    if dist > 400 then
        maxStep = 38
    elseif dist > 150 then
        maxStep = 32
    end

    local dir = (islandGoal - cur).Unit
    local targetPos = cur + dir * math.min(maxStep, dist)
    local look = CFrame.lookAt(targetPos, islandGoal)

    cancelTween(islandTween)
    islandTween = TweenService:Create(
        h,
        TweenInfo.new(ISLAND_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = look }
    )
    islandTween:Play()
    zeroVel(h)
    freezeHum()
    return false
end

local function FindMob(name, range)
    if not name then return nil end
    range = range or DETECT_RANGE
    local h = HRP()
    if not h then return nil end
    local best = nil
    local bestD = range

    local function consider(m)
        if not m or not m:IsA("Model") then return end
        if m.Name == name then
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = m:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                local d = (h.Position - root.Position).Magnitude
                if d < bestD then
                    best = m
                    bestD = d
                end
            end
        end
    end

    pcall(function()
        local folder = workspace:FindFirstChild("Enemies")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                consider(m)
            end
        end
    end)
    return best
end

local function BringSameName(name)
    if not State.BringMob or not name then return end
    local h = HRP()
    if not h then return end
    local target = FindMob(name, DETECT_RANGE)
    local pivot = target and target:FindFirstChild("HumanoidRootPart")
    local base = pivot and pivot.CFrame or (h.CFrame * CFrame.new(0, 0, -6))

    pcall(function()
        local folder = workspace:FindFirstChild("Enemies")
        if not folder then return end
        local n = 0
        for _, m in ipairs(folder:GetChildren()) do
            if m.Name == name and m:IsA("Model") then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local root = m:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = (h.Position - root.Position).Magnitude
                    if d < BRING_RANGE then
                        root.CFrame = base * CFrame.new((n % 4) * 2.2, 0, math.floor(n / 4) * 2.2)
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.zero
                        end)
                        n = n + 1
                        if n > 10 then break end
                    end
                end
            end
        end
    end)
end

