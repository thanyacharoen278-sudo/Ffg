local function ApplyMagnitude(c)
    if not c then return end
    c.hitboxMagnitude = HITBOX
    c.timeToNextAttack = 0
    c.attacking = false
    c.blocking = false
    if type(c.increment) == "number" then c.increment = 4 end
    if type(c.focusStart) == "number" then c.focusStart = 0 end
end

local function FloatTo(mob)
    local h = HRP()
    if not h or not mob then return end
    local root = mob:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local goal = root.Position + Vector3.new(0, FLOAT_HEIGHT, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    local lookTarget = root.Position + Vector3.new(0, 0.25, 0)

    if dist < 3 then
        cancelTween(floatTween)
        floatTween = nil
        h.CFrame = CFrame.lookAt(goal, lookTarget)
        zeroVel(h)
        freezeHum()
        lastFloatPos = goal
        return
    end

    if floatTween and floatTween.PlaybackState == Enum.PlaybackState.Playing then
        if lastFloatPos and (lastFloatPos - goal).Magnitude < 5 then
            zeroVel(h)
            freezeHum()
            return
        end
    end

    local maxStep = 10
    if dist > 100 then
        maxStep = 20
    elseif dist > 40 then
        maxStep = 14
    end

    local dir = (goal - cur).Unit
    local targetPos = cur + dir * math.min(maxStep, dist)
    lastFloatPos = goal

    local look = CFrame.lookAt(targetPos, lookTarget)

    cancelTween(floatTween)
    floatTween = TweenService:Create(
        h,
        TweenInfo.new(FLOAT_TWEEN_TIME, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { CFrame = look }
    )
    floatTween:Play()
    zeroVel(h)
    freezeHum()
end

