local function Attack()
    Equip()
    pcall(function()
        if AC and AC.activeController then
            local c = AC.activeController
            c.timeToNextAttack = 0
            c.hitboxMagnitude = 90
        end
    end)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
    end)
    task.wait(0.03)
    pcall(function()
        VU:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        local x = 400
        local y = 300
        if cam then
            x = cam.ViewportSize.X / 2
            y = cam.ViewportSize.Y / 2
        end
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    pcall(function()
        local c = LP.Character
        if c then
            local t = c:FindFirstChildOfClass("Tool")
            if t then t:Activate() end
        end
    end)
end

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local near, best = nil, range or 5000
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d < best then
                near = m
                best = d
            end
        end
    end
    return near
end

local function GetFarEnemy(minD)
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, math.huge
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d > (minD or 50) and d < bestD then
                best = m
                bestD = d
            end
        end
    end
    return best
end

local function GetNearestPlayer()
    local h = HRP()
    if not h then return nil end
    local near, best = nil, 2500
    for _, plr in pairs(Players:GetPlayers()) do
        if plr \~= LP and plr.Character then
            local mh = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 then
                local d = (h.Position - mh.Position).Magnitude
                if d < best then
                    near = mh
                    best = d
                end
            end
        end
    end
    return near
end

local function BringMobs(pos)
    if not _G.BringMob then return end
    pcall(function()
        local folder = workspace:FindFirstChild("Enemies")
        if not folder then return end
        for _, m in pairs(folder:GetChildren()) do
            local mh = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 then
                local d = (mh.Position - pos).Magnitude
                if d < 280 and d > 6 then
                    mh.CFrame = CFrame.new(pos + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)))
                    mh.CanCollide = false
                end
            end
        end
    end)
end

